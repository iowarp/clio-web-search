# Container image. A digest provides immutable deployments.
CLIO_WEB_SEARCH_IMAGE=ghcr.io/iowarp/clio-web-search:0.3.0

# Host listener. Use a trusted LAN address only when remote clients need access.
CLIO_WEB_SEARCH_BIND_ADDRESS=127.0.0.1
CLIO_WEB_SEARCH_PORT=8089
CLIO_WEB_SEARCH_VALKEY_PORT=8090

# Optional scholarly-provider configuration.
CLIO_WEB_SEARCH_CONTACT_EMAIL=
CLIO_WEB_SEARCH_OPENALEX_API_KEY=

# Persistent Docker volume.
CLIO_WEB_SEARCH_DATA_VOLUME=clio-web-search-data
CLIO_WEB_SEARCH_VALKEY_DATA_PATH=/data/clio-web-search/valkey

# Document and queue limits.
CLIO_WEB_SEARCH_MAX_INPUT_BYTES=52428800
CLIO_WEB_SEARCH_WORKERS=1
CLIO_WEB_SEARCH_MAX_PENDING_JOBS=32

# Cache retention and size budget.
CLIO_WEB_SEARCH_CACHE_TTL_DAYS=7
CLIO_WEB_SEARCH_CACHE_MAX_BYTES=10737418240

# Per-request network timeouts. Document conversion has no overall timeout.
CLIO_WEB_SEARCH_REQUEST_TIMEOUT_S=30
CLIO_WEB_SEARCH_GROBID_REQUEST_TIMEOUT_S=900

# Active-conversion heartbeat interval.
CLIO_WEB_SEARCH_PROGRESS_INTERVAL_S=5

# Agent-local FastMCP/Docket discovery. The Web MCP receives only the HTTP URL
# and discovers the Valkey port and queue namespace from the service.
CLIO_WEB_SEARCH_DEPLOYMENT_ID=homelab
CLIO_WEB_SEARCH_TASK_BACKEND_PUBLIC_HOST=

# Trusted-network mode is the default. Set a token to require authenticated
# discovery and provision per-agent Valkey ACL users.
CLIO_WEB_SEARCH_TASK_BACKEND_API_TOKEN=

# Optional TLS mode requires mounted certificate, key, and CA files.
CLIO_WEB_SEARCH_TASK_BACKEND_TLS=false
CLIO_WEB_SEARCH_TASK_BACKEND_TLS_CERT_FILE=
CLIO_WEB_SEARCH_TASK_BACKEND_TLS_KEY_FILE=
CLIO_WEB_SEARCH_TASK_BACKEND_CA_PATH=
